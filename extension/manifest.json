{
  "manifest_version": 3,
  "name": "Application Composer Companion",
  "description": "Capture job descriptions or application fields for OnlineJobs.ph, Upwork and other websites. Review answers locally and submit yourself.",
  "version": "0.3.3",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:32187/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Application Composer" },
  "content_scripts": [{ "matches": ["http://127.0.0.1:32187/*"], "js": ["local-bridge.js"], "run_at": "document_idle" }]
}
